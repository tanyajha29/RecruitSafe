# Environment
ENVIRONMENT=development  # development or production
LOG_LEVEL=INFO
PORT=8000

# Database Configuration (MongoDB Atlas / Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/recruitsafe?retryWrites=true&w=majority

# Authentication Settings
JWT_SECRET_KEY=generate-a-secure-random-256-bit-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# AI Engine Settings (Multi-Provider: groq, gemini, mock)
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=optional-gemini-api-key-here

# Tesseract OCR Configuration
# On Windows, set this to the path of your tesseract.exe, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract

# Mail Configuration (optional for development password resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=noreply@recruitsafe.com

# CORS & Rate Limiting
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_HOUR=100
